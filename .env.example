# Local development binds to loopback. Do not commit a real .env file.
APP_MODE=development
HOST=127.0.0.1
PORT=5001
DATABASE_PATH=.data/workspaces.sqlite
# Optional real seed, kept outside Git:
# SEED_FILE=.data/seed.private.json

# For standalone hosting, set APP_MODE=standalone and use HTTPS.
# HOST=0.0.0.0
# APP_BASIC_USER=owner
# APP_BASIC_PASSWORD=replace-with-a-long-random-password

# APP_MODE=perplexity is ONLY for the authenticated Perplexity private proxy.
# Never use that mode on an unprotected public server.
